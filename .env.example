# Solana RPC endpoint.
#
# The public endpoint (https://api.mainnet-beta.solana.com) rate-limits
# getTokenLargestAccounts with HTTP 429, which disables the holder-concentration
# gate — the single most useful rug filter here. Use a real RPC.
#
# Free tiers that work: Helius, QuickNode, Alchemy, Shyft.
#   https://helius.dev  ->  https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Milliseconds to wait between RPC batches. Raise if you get 429s.
RPC_THROTTLE_MS=120
